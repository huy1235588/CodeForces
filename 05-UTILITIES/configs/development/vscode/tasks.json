{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: Build and Run",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-O2",
                "-Wall",
                "-Wextra",
                "-DLOCAL",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "&&",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "cwd": "${fileDirname}"
            }
        },
        {
            "label": "C++: Build Only",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-O2",
                "-Wall",
                "-Wextra",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "cwd": "${fileDirname}"
            }
        },
        {
            "label": "C++: Build for Contest (Optimized)",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-O3",
                "-march=native",
                "-funroll-loops",
                "-ffast-math",
                "-DONLINE_JUDGE",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "cwd": "${fileDirname}"
            }
        },
        {
            "label": "Python: Run",
            "type": "shell",
            "command": "python",
            "args": [
                "${file}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "options": {
                "cwd": "${fileDirname}"
            }
        },
        {
            "label": "Java: Build and Run",
            "type": "shell",
            "command": "javac",
            "args": [
                "${file}",
                "&&",
                "java",
                "${fileBasenameNoExtension}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "options": {
                "cwd": "${fileDirname}"
            }
        },
        {
            "label": "Create New Contest Folder",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "$contestName = Read-Host 'Enter contest name (e.g., cf-round-900)'; $folderPath = '01-CORE-LEARNING/practice/contests/codeforces/' + $contestName; New-Item -ItemType Directory -Path $folderPath -Force; @('A', 'B', 'C', 'D', 'E', 'F') | ForEach-Object { Copy-Item '01-CORE-LEARNING/code/cpp/template.cpp' ($folderPath + '/' + $_ + '.cpp') }; Write-Host 'Contest folder created: ' $folderPath"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}